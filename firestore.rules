rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{document} {
      allow read, write: if true;
    }

    match /sales/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /fetchLogs/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
